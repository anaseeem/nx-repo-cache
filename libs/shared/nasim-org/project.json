{
  "name": "nasim-org",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/shared/nasim-org/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "options": {
        "cwd": "{projectRoot}",
        "tsConfig": "{projectRoot}/tsconfig.lib.json",
        "outputPath": "{workspaceRoot}/dist/{projectRoot}",
        "main": "{projectRoot}/core/src/index.ts",
        "additionalEntryPoints": [
          "{projectRoot}/server/index.ts",
          "{projectRoot}/src/demo.ts"
        ],
        "generateExportsField": true,
        "assets": [
          "{projectRoot}/*.md",
          "{projectRoot}/src/**/!(*.ts)",
          "{projectRoot}/server/**/!(*.ts)"
        ],
        "clean": true
      },
      "outputs": ["{options.outputPath}"]
    }
  }
}
